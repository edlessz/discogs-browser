# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real keys.

# Last.fm API key (https://www.last.fm/api/account/create)
VITE_LASTFM_API_KEY=your_lastfm_api_key
VITE_LASTFM_SECRET=your_lastfm_secret

# Last.fm username whose listening is displayed
VITE_LASTFM_USER=your_lastfm_username

# Discogs username whose collection is browsed (public collection, no token needed)
VITE_DISCOGS_USERNAME=your_discogs_username
